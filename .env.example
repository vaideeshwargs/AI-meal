# ==============================================================================
# AI Smart Meal Planner - Environment Variables Template
# Copy this file to .env and supply your credentials. NEVER commit .env to git.
# ==============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=production

# GEMINI_API_KEY: Required for Gemini AI API calls (meal plan generation, smart chat, meal swaps).
# In Google AI Studio, this is automatically injected at runtime.
# For self-hosted or cloud deployments, generate a key at https://aistudio.google.com/
GEMINI_API_KEY=""

# APP_URL: Public URL where the app is hosted (e.g., https://your-domain.run.app)
APP_URL="http://localhost:3000"

# Supabase PostgreSQL Configuration (Optional - app automatically falls back to in-memory store if unset)
# SUPABASE_URL: Your Supabase project URL (e.g., https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=""
# SUPABASE_ANON_KEY: Your Supabase public anonymous API key (safe for client queries)
SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY: Optional service role key for migrations and administrative backend operations
SUPABASE_SERVICE_ROLE_KEY=""
